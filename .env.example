# 1. Supabase Project Configuration (Client & Backend)
# The public HTTPS API URL for your Supabase project
VITE_SUPABASE_URL=https://mkhzvzgluddaqaxilgkz.supabase.co
SUPABASE_URL=https://mkhzvzgluddaqaxilgkz.supabase.co

# 2. Supabase Anonymous / Publishable Key (Client Safe)
# Used in frontend Vite builds to query public tables protected by RLS
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key

# 3. Supabase Service Role Secret Key (SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER)
# Required by /api/auth/login, /api/auth/register, and /api/admin/provision-user
# Set this in Vercel Project Settings -> Environment Variables
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
